---
// Home page (plan phase 4): hero with the scroll-driven figure, selected systems, earlier
// work and timeline, contact. Copy stays under 350 words (tests/e2e/home.spec.ts).
import { getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import Contact from "../components/home/Contact.astro";
import Earlier from "../components/home/Earlier.astro";
import Hero from "../components/home/Hero.astro";
import Systems from "../components/home/Systems.astro";

const p = (await getEntry("profile", "aditya"))!.data;
---

<Base title={p.name} description={`${p.name}, ${p.job_title} at ${p.employer.name}, ${p.location.city}.`}>
  <Hero />
  <Systems />
  <Earlier />
  <Contact />
</Base>
