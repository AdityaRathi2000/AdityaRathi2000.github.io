---
/*
  Hero figure, static frame (style tile version).
  Entity resolution on one fictional provider: six source records share a blocking key,
  pairwise links are accepted or rejected, five records collapse into one canonical provider.
  Synthetic data, real mechanism: the dashed frame and caption are required (review checklist V2).
  No stage counts yet; those bind to the metrics registry in P4.T2.
*/
import { sketch } from "../../lib/rough";
import RoughPaths from "../RoughPaths.astro";

const s = sketch(20261026);

// Content sits inside a dashed frame; everything below is in content coordinates.
const PAD = 14;
const W = 420;
const H = 440;

interface Card {
  label: string;
  x: number;
  y: number;
  w: number;
  rot: number;
}

const CARD_H = 40;
const cards: Record<string, Card> = {
  c1: { label: "Larkspur Technical College", x: 14, y: 20, w: 220, rot: -2 },
  c2: { label: "Larkspur Tech", x: 276, y: 28, w: 124, rot: 3 },
  c3: { label: "LTC Workforce Ed.", x: 250, y: 118, w: 156, rot: -2 },
  c4: { label: "Larkspur Comm. & Tech.", x: 24, y: 110, w: 200, rot: 1.5 },
  c5: { label: "Larkspur Technical Coll.", x: 10, y: 204, w: 206, rot: -1 },
  c6: { label: "Larkspur Bookstore", x: 252, y: 212, w: 164, rot: 2.5 },
};
const centre = (c: Card): [number, number] => [c.x + c.w / 2, c.y + CARD_H / 2];

// Stage 2: one blocking key groups all six records.
const block = s.rect(0, 2, W, 262, { hachure: true, tone: "muted", width: 1 });

// Stage 3: candidate pairs. Accepted links solid, the rejected one dashed.
const link = (a: string, b: string, o = {}) => s.line(...centre(cards[a]), ...centre(cards[b]), { width: 1.1, ...o });
const links = [
  ...link("c1", "c2"),
  ...link("c1", "c4"),
  ...link("c2", "c3"),
  ...link("c4", "c5", { tone: "accent", width: 1.8 }),
  ...link("c5", "c6", { tone: "muted", dash: [5, 5] }),
];

const tick = (x: number, y: number, tone?: "accent") => s.path(`M${x - 6} ${y} L${x - 1.5} ${y + 5} L${x + 7} ${y - 6}`, { width: 1.6, roughness: 0.6, tone });
const cross = (x: number, y: number) => [
  ...s.line(x - 5, y - 5, x + 5, y + 5, { width: 1.6, roughness: 0.6 }),
  ...s.line(x + 5, y - 5, x - 5, y + 5, { width: 1.6, roughness: 0.6 }),
];
const marks = [...tick(255, 33), ...tick(136, 85), ...tick(344, 93), ...tick(134, 177, "accent"), ...cross(236, 214)];

const cardShapes = Object.entries(cards).map(([id, c]) => ({
  id,
  c,
  outline: s.rect(c.x, c.y, c.w, CARD_H, { width: 1.2 }),
}));

// Stage 4: the merge.
const arrow = [...s.line(210, 272, 210, 336, { width: 1.3 }), ...s.path("M202 326 L210 338 L218 326", { width: 1.3, roughness: 0.7 })];
const canonical = [...s.rect(70, 348, 280, 50, { width: 1.4 }), ...s.rect(66, 344, 288, 58, { width: 0.9, roughness: 1.6 })];
const frame = s.rect(-PAD + 3, -PAD + 3, W + 2 * PAD - 6, H + 2 * PAD - 6, { tone: "muted", dash: [7, 6], width: 1.1, roughness: 0.8 });
---

<svg
  class="rough er-sketch"
  viewBox={`${-PAD} ${-PAD} ${W + 2 * PAD} ${H + 2 * PAD}`}
  role="img"
  aria-labelledby="er-title er-desc"
>
  <title id="er-title">Entity resolution on one fictional provider</title>
  <desc id="er-desc">
    Six records from different sources all share one blocking key. Pairwise links between them are checked; one close call
    is accepted by the model and the link to the bookstore is rejected. The five matching records merge into one
    canonical provider, Larkspur Technical College.
  </desc>
  <RoughPaths paths={frame} />
  <RoughPaths paths={block} />
  <RoughPaths paths={links} />
  {
    cardShapes.map(({ c, outline }) => (
      <g transform={`rotate(${c.rot} ${c.x + c.w / 2} ${c.y + CARD_H / 2})`}>
        <rect class="r-solid" x={c.x} y={c.y} width={c.w} height={CARD_H} />
        <RoughPaths paths={outline} />
        <text x={c.x + c.w / 2} y={c.y + CARD_H / 2 + 5} text-anchor="middle" font-size="15">
          {c.label}
        </text>
      </g>
    ))
  }
  <RoughPaths paths={marks} />
  <text class="r-note" x="4" y="292" font-size="15">one shared blocking key</text>
  <text class="r-note" x="224" y="292" font-size="15">close calls go to an LLM</text>
  <RoughPaths paths={arrow} />
  <rect class="r-solid" x="70" y="348" width="280" height="50" />
  <RoughPaths paths={canonical} />
  <text x="210" y="379" text-anchor="middle" font-size="17" font-weight="500">Larkspur Technical College</text>
  <text class="r-note" x="210" y="428" text-anchor="middle" font-size="15">one canonical provider</text>
</svg>
