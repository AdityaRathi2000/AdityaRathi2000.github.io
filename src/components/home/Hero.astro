---
/*
  Home hero (plan P4.T1-T2): who, where, the positioning paragraph from profile.yaml, proof
  links, and the entity-resolution figure with four steps beside it. The steps carry the real
  numbers (from the registry, via <Metric>); the figure inside its dashed frame stays synthetic.
  With motion allowed, the steps space out and the figure stays in view while they scroll by,
  scrubbing the stages; otherwise the steps are a plain list beside a fully drawn figure.
*/
import { getEntry } from "astro:content";
import Metric from "../Metric.astro";
import MetricNote from "../MetricNote.astro";
import HeroFunnel from "./HeroFunnel.astro";

const p = (await getEntry("profile", "aditya"))!.data;
---

<section class="hero" data-hero aria-labelledby="hero-name">
  <div class="hero-intro">
    <h1 id="hero-name">{p.name}</h1>
    <p class="role">{p.job_title} at {p.employer.name}, <span class="nowrap">{p.location.city}</span></p>
    <p class="lede">{p.positioning}</p>
    <p class="proof">
      <a href={p.links.github}>GitHub</a>
      <a href={p.links.linkedin}>LinkedIn</a>
      <a href="/resume.pdf">Résumé (PDF)</a>
    </p>
  </div>

  <div class="hero-figure-col">
    <figure class="hero-figure">
      <HeroFunnel />
      <figcaption>
        <em>Synthetic data, real mechanism.</em> Entity resolution on one fictional provider.
      </figcaption>
    </figure>
  </div>

  <ol class="hero-steps" data-hero-steps aria-label="How entity resolution works">
    <li data-step="0">
      <strong class="step-title">Records arrive</strong>
      <p>The same provider comes in from <Metric id="cvi-sources" /> sources, each spelling its name its own way.</p>
      <MetricNote id="cvi-sources" />
    </li>
    <li data-step="1">
      <strong class="step-title">Blocking</strong>
      <p>Only records that share a key are compared, not every pair.</p>
    </li>
    <li data-step="2">
      <strong class="step-title">Judgement</strong>
      <p>Embedding similarity proposes pairs; an LLM decides the close calls and rejects the bookstore.</p>
    </li>
    <li data-step="3">
      <strong class="step-title">Merge</strong>
      <p>Accepted pairs become one canonical provider. The July 2026 release lists <Metric id="cvi-providers" /> of them.</p>
      <MetricNote id="cvi-providers" />
    </li>
  </ol>
</section>

<script>
  // Load the scroll driver only when it will be used, and after the page has settled.
  const root = document.querySelector<HTMLElement>("[data-hero]");
  if (root && document.documentElement.classList.contains("hero-motion")) {
    const go = () =>
      import("../../scripts/hero-funnel")
        .then((m) => m.start(root))
        // If the driver cannot load, show the assembled figure rather than a stuck first stage.
        .catch(() => document.documentElement.classList.remove("hero-motion"));
    if ("requestIdleCallback" in window) requestIdleCallback(go, { timeout: 1200 });
    else setTimeout(go, 200);
  }
</script>

<style>
  .hero {
    display: grid;
    gap: var(--space-l) var(--space-xl);
    padding-block: var(--space-xl) var(--space-l);
  }

  .hero-intro {
    display: grid;
    gap: var(--space-m);
    align-content: start;
  }

  .role {
    font-size: var(--step-1);
    line-height: 1.3;
    margin-top: calc(var(--space-2xs) * -1);
  }

  .nowrap {
    white-space: nowrap;
  }

  .lede {
    max-width: 56ch;
  }

  .proof {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-m);
  }

  .proof a {
    color: var(--ink);
    text-decoration-color: var(--ink-2);
  }

  .proof a:hover {
    color: var(--accent);
    text-decoration-color: currentColor;
  }

  .hero-figure {
    margin: 0;
    max-width: 30rem;
  }

  .hero-figure figcaption {
    margin-top: var(--space-xs);
    font-size: var(--step--1);
    color: var(--ink-2);
    line-height: 1.45;
  }

  .hero-figure figcaption em {
    color: var(--ink);
  }

  .hero-steps {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-m);
    max-width: 44ch;
  }

  .step-title {
    display: block;
    font-size: var(--step-1);
    font-weight: 500;
    line-height: 1.2;
    margin-bottom: var(--space-3xs);
  }

  .hero-steps p {
    color: var(--ink-2);
  }

  /* Scroll-driven version: steps spread out, the figure stays in view while they pass. */
  :global(.hero-motion) .hero-steps {
    gap: 42vh;
    padding-bottom: 12vh;
  }

  /* Steps not in play recede to the secondary ink (which keeps WCAG AA contrast); never opacity. */
  :global(.hero-motion) .hero-steps li {
    color: var(--ink-2);
    transition: color 0.3s ease;
  }

  :global(.hero-motion) .hero-steps li:global(.is-current),
  :global(.hero-motion) .hero-steps li:global(.is-current) p {
    color: var(--ink);
  }

  /* Phone: the figure sticks to the top while the steps scroll beneath it. */
  @media (max-width: 899px) {
    :global(.hero-motion) .hero-figure-col {
      position: sticky;
      top: 0;
      z-index: 1;
      background: var(--paper);
      padding-block: var(--space-2xs);
    }

    /* Keyboard focus would otherwise stop under the column above (WCAG 2.4.11). Bound on its
       height: the figure is at most 44vh, caption and padding under 7rem. */
    :global(.hero-motion) .hero-steps :global(:is(a, summary, button)) {
      scroll-margin-top: calc(44vh + 7rem);
    }

    :global(.hero-motion) .hero-figure :global(svg) {
      max-height: 44vh;
      width: auto;
      margin-inline: auto;
    }

    :global(.hero-motion) .hero-figure figcaption {
      text-align: center;
    }
  }

  /* Wide: intro and steps on the left, the figure sticky on the right for the whole section. */
  @media (min-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      align-items: start;
    }

    .hero-intro {
      grid-column: 1;
      grid-row: 1;
      padding-top: var(--space-l);
    }

    .hero-steps {
      grid-column: 1;
      grid-row: 2;
    }

    .hero-figure-col {
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: stretch;
    }

    .hero-figure {
      position: sticky;
      top: var(--space-l);
    }
  }

  @media print {
    .hero-steps {
      gap: var(--space-m) !important;
      padding-bottom: 0 !important;
    }

    .hero-steps li,
    .hero-steps p {
      color: var(--ink) !important;
    }
  }
</style>
