---
/*
  Row thumbnail for the weather model: a probability for each temperature bracket of one
  day's high. A pictogram of what the model outputs; the bar heights are not data.
  The live reliability diagram replaces this in P4.T3 once the feed exists (P7).
*/
import { sketch } from "../../lib/rough";
import RoughPaths from "../RoughPaths.astro";

const s = sketch(3103);

const heights = [10, 26, 52, 84, 62, 30, 12];
const bars = heights.flatMap((h, i) => s.rect(36 + i * 24, 128 - h, 18, h, i === 3 ? { tone: "accent", width: 1.6, roughness: 0.7 } : { hachure: true, width: 1, roughness: 0.7 }));
const axis = s.line(28, 129, 208, 129, { width: 1.2 });
const frame = s.rect(4, 2, 220, 158, { width: 1.1, roughness: 0.9 });
---

<svg class="rough thumb" viewBox="0 0 228 164" role="img" aria-labelledby="kalshi-thumb-title">
  <title id="kalshi-thumb-title">Sketch of a forecast as a probability for each temperature bracket of one day's high</title>
  <RoughPaths paths={frame} />
  <RoughPaths paths={bars} />
  <RoughPaths paths={axis} />
  <text class="r-note" x="118" y="148" text-anchor="middle" font-size="15">temperature brackets</text>
</svg>
