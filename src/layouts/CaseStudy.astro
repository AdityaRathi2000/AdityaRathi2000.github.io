---
/*
  Case-study page (plan P5.T1): title and summary, an evidence strip of the headline numbers
  that are ready (each with its comparator or scope note, never a draft), the architecture
  figure, the prose (MDX), the interactive explorer when the study has one (plan P6), What I got
  wrong, optional engineering notes, then previous / next.
*/
import { getEntry, type CollectionEntry } from "astro:content";
import Base from "./Base.astro";
import Diagram from "../components/Diagram.astro";
import ErExplorer from "../components/er/ErExplorer.astro";
import KalshiResult from "../components/kalshi/KalshiResult.astro";
import NerWalkthrough from "../components/ner/NerWalkthrough.astro";
import Metric from "../components/Metric.astro";
import MetricNote from "../components/MetricNote.astro";

interface Props {
  study: CollectionEntry<"caseStudies">;
  prev: CollectionEntry<"caseStudies"> | null;
  next: CollectionEntry<"caseStudies"> | null;
}

const { study, prev, next } = Astro.props;
const d = study.data;
// <title> stays within 70 characters (search results truncate past that; html-validate enforces it).
const suffix = " | Aditya Rathi";
const pageTitle = d.title.length + suffix.length <= 70 ? d.title + suffix : d.title;
const kind = { production: "Production system", personal: "Personal project", client: "Client work" }[d.kind];
const evidence = (await Promise.all(d.headline_metrics.map((r) => getEntry("metrics", r.id)))).filter((m) => m && m.data.status === "ready");
const prompts = {
  believed: "Something I believed that turned out to be false",
  "measure-first": "What I would measure first if I rebuilt it",
  "still-cannot": "What it still cannot do",
} as const;
const notes = d.notes ? Object.entries(d.notes).filter(([, v]) => v) : [];
const noteLabel: Record<string, string> = { reruns: "Reruns", cost: "Cost", lineage: "Lineage", gates: "Gates" };
---

<Base title={pageTitle} description={d.summary} ogSlug={study.id}>
  <article class="case" data-case-study={study.id}>
    <header class="case-head">
      <p class="case-meta">{kind}, {d.period}</p>
      <h1>{d.title}</h1>
      <p class="summary">{d.summary}</p>
      <p class="stack">Built with {d.stack.join(", ")}.</p>
    </header>

    {
      evidence.length > 0 && (
        <section class="evidence" aria-label="The numbers">
          <ul>
            {evidence.map((m) => (
              <li>
                <span class="ev-num">
                  <Metric id={m!.id} bare />
                </span>
                <span class="ev-label">{m!.data.label}</span>
                <MetricNote id={m!.id} />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      d.diagram && (
        <div class="case-figure">
          <Diagram name={d.diagram} />
        </div>
      )
    }

    <div class="prose">
      <slot />
    </div>

    {d.interactive === "er-funnel" && <ErExplorer />}
    {d.interactive === "kalshi-reliability" && <KalshiResult />}
    {d.interactive === "ner-walkthrough" && <NerWalkthrough />}

    <section class="wrong" aria-labelledby="wrong-title">
      <h2 id="wrong-title">What I got wrong</h2>
      <dl>
        {
          d.what_i_got_wrong.map((w) => (
            <div>
              <dt>{prompts[w.prompt]}</dt>
              <dd>{w.answer}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    {
      notes.length > 0 && (
        <section class="notes" aria-labelledby="notes-title">
          <h2 id="notes-title">Engineering notes</h2>
          <dl>
            {notes.map(([k, v]) => (
              <div>
                <dt>{noteLabel[k]}</dt>
                <dd>{v}</dd>
              </div>
            ))}
          </dl>
        </section>
      )
    }

    <nav class="pager" aria-label="More case studies">
      {prev ? <a rel="prev" href={`/work/${prev.id}/`}>Previous: {prev.data.title}</a> : <span />}
      {next ? <a rel="next" href={`/work/${next.id}/`}>Next: {next.data.title}</a> : <a href="/#work">All selected systems</a>}
    </nav>
  </article>
</Base>

<style>
  .case {
    display: grid;
    /* minmax(0, 1fr): without it the column grows to its widest child's min-content (overflow on phones). */
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-l);
    padding-block: var(--space-xl) var(--space-l);
  }

  .case-head {
    display: grid;
    gap: var(--space-s);
    max-width: var(--measure);
  }

  .case-meta,
  .stack {
    color: var(--ink-2);
    font-size: var(--step--1);
  }

  .summary {
    font-size: var(--step-1);
    line-height: 1.4;
  }

  .evidence ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    max-width: 60rem;
  }

  .evidence li {
    display: grid;
    gap: var(--space-3xs);
    align-content: start;
    border-top: 1px solid color-mix(in srgb, var(--ink-2) 35%, transparent);
    padding-top: var(--space-xs);
  }

  .ev-num {
    font-size: var(--step-2);
    line-height: 1.1;
  }

  .ev-label {
    color: var(--ink-2);
  }

  .case-figure {
    max-width: 34rem;
  }

  .prose {
    max-width: var(--measure);
    display: grid;
    gap: var(--space-s);
  }

  .prose :global(h2) {
    margin-top: var(--space-m);
  }

  .prose :global(ol),
  .prose :global(ul) {
    padding-left: 1.4em;
    display: grid;
    gap: var(--space-2xs);
  }

  .wrong,
  .notes {
    max-width: var(--measure);
    border-top: 1px solid color-mix(in srgb, var(--ink-2) 35%, transparent);
    padding-top: var(--space-m);
  }

  .wrong h2,
  .notes h2 {
    margin-bottom: var(--space-s);
  }

  dl {
    display: grid;
    gap: var(--space-s);
  }

  dt {
    font-style: italic;
    color: var(--ink-2);
  }

  .pager {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-s) var(--space-l);
    border-top: 1px solid color-mix(in srgb, var(--ink-2) 35%, transparent);
    padding-top: var(--space-m);
  }
</style>
